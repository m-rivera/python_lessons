art":{"line":90,"column":1},"end":{"line":90,"column":1}},"children":[{"type":"text","value":"Hint: to separate a string into a list of strings based on the position of the whitespaces, use ","position":{"start":{"line":90,"column":1},"end":{"line":90,"column":1}},"key":"mHvktrFTMS"},{"type":"inlineCode","value":"list_of_substrings = example_string.split()","position":{"start":{"line":90,"column":1},"end":{"line":90,"column":1}},"key":"AwOp8USkDz"},{"type":"text","value":".","position":{"start":{"line":90,"column":1},"end":{"line":90,"column":1}},"key":"TUPKTkthYm"}],"key":"saFHIaqTru"}],"key":"YloF8xWQv4"},{"type":"details","children":[{"type":"summary","children":[{"type":"text","value":"Solution","key":"noPITjUsES"}],"key":"l6RNSDZhOO"},{"type":"text","value":"This task has many possible solutions. In any case, some `for` loops will be required and the numbers read in a strings should be converted to floats.","key":"zpLIvvtbFG"},{"type":"code","lang":"python","meta":null,"value":"wavenumbers = []\ntransmittances = []\nwith open(\"acetone.jdx\") as acetone_file:\n    # loop over every line\n    for line in acetone_file:\n        # check that the line doesn't start with #\n        if line[0] != \"#\":\n            # separate the line into substrings\n            split_line = line.split()\n            # the first number is a wavenumber\n            wavenumbers.append(float(split_line[0]))\n            # average all the other numbers\n            current_transmittance = 0\n            for number in split_line[1:]:\n                current_transmittance = current_transmittance + float(number)\n            # find the average of five measurements\n            current_transmittance = current_transmittance / 5\n            transmittances.append(current_transmittance)\n\n# plot\nimport matplotlib.pyplot as plt\nplt.plot(wavenumbers, transmittances)\nplt.show()","key":"w80mQVxtUU"}],"key":"CK3OkHUUjV"},{"type":"heading","depth":2,"position":{"start":{"line":123,"column":1},