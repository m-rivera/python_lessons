cvg"},{"type":"thematicBreak","key":"SXbG73JMpr"},{"type":"heading","depth":2,"position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"children":[{"type":"text","value":"Goals of the Meeting","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"key":"dBfJZNBdcY"}],"identifier":"goals-of-the-meeting","label":"Goals of the Meeting","html_id":"goals-of-the-meeting","implicit":true,"key":"PfonhzSrTS"},{"type":"paragraph","position":{"start":{"line":11,"column":1},"end":{"line":11,"column":1}},"children":[{"type":"text","value":"In discussions at the previous two Python in Chemistry Meetings, it has become clear that Python is being taught in different ways at different institutions. Partly this is a function of the mode and timing of delivery: whether it is delivered in core or optional modules; whether in a standalone module or as part of a broader skills module; to which year group(s); which applications are in focus. As a result of this variation in logistics, the goals, methods and structure of our Python teaching practice diverge. We aim to use this meeting to showcase some of these different approaches, and provide attendees an opportunity to dicuss with other educators how their teaching methods and materials could be adapted to suit the particular constraints and requirements of their institution.","position":{"start":{"line":11,"column":1},"end":{"line":11,"column":1}},"key":"TUEqVEIq5S"}],"key":"lk93tqnJys"},{"type":"heading","depth":2,"position":{"start":{"line":13,"column":1},"end":{"line":13,"column":1}},"children":[{"type":"text","value":"Meeting details","position":{"start":{"line":13,"column":1},"end":{"line":13,"column":1}},"key":"bvi09tdaPM"}],"identifier":"meeting-details","label":"Meeting details","html_id":"meeting-details","implicit":true,"key":"NWpBFV40kW"},{"type":"paragraph","position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"children":[{"type":"text","value":"The meeting will take place in