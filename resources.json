{"version":3,"kind":"Article","sha256":"b5bc770767cc55231761a685942af5b01660e58b02799ce70525b1383804d9db","slug":"resources","location":"/resources.md","dependencies":[],"frontmatter":{"title":"Shared Resource","content_includes_title":false,"authors":[{"nameParsed":{"literal":"The Python in Chemistry Community","given":"The Python","non_dropping_particle":"in","family":"Chemistry Community"},"name":"The Python in Chemistry Community","id":"contributors-myst-generated-uid-0"}],"copyright":"2026","numbering":{"title":{"offset":1}},"thumbnail":"/python_lessons/build/group-photo-391ce598dbf38161b374cc77ba1aded1.jpeg","exports":[{"format":"md","filename":"resources.md","url":"/python_lessons/build/resources-9beca8f525be18909733148219fa2910.md"}]},"mdast":{"type":"root","children":[{"type":"block","children":[{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"Miguel Rivera (UCL) & Andrew R. McCluskey (Bristol)","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"G1h29U4VrJ"}],"key":"vWv9kHYMnL"},{"type":"thematicBreak","key":"JGA8uhT88j"},{"type":"paragraph","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"children":[{"type":"text","value":"This is the second blog post about the 5","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"key":"DRg7pKzjPe"},{"type":"superscript","children":[{"type":"text","value":"th","key":"TPko0qlbkI"}],"key":"bOxutDcSih"},{"type":"text","value":" of April 2024 meeting on teaching Pythin in Chemistry.","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"key":"dXgquffGVY"}],"key":"EeUNKqjsFk"},{"type":"heading","depth":2,"position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"children":[{"type":"text","value":"Shared resource","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"key":"ViuPRdUGxW"}],"identifier":"shared-resource","label":"Shared resource","html_id":"shared-resource","implicit":true,"key":"PhQTsyHUWv"},{"type":"paragraph","position":{"start":{"line":11,"column":1},"end":{"line":14,"column":1}},"children":[{"type":"text","value":"Perhaps the most active discussion at our meeting was about creating a platform for sharing resources relating to teaching Python in Chemistry.\nThis would be an ambitious cross-institution project, catering to every teaching style outlined in the previous post.\n","position":{"start":{"line":11,"column":1},"end":{"line":11,"column":1}},"key":"kzQyB5pErr"},{"type":"strong","position":{"start":{"line":11,"column":1},"end":{"line":11,"column":1}},"children":[{"type":"text","value":"The initial proposal would be that a single entry point is created to all of the existing material, with clear guidance on how to add new resources.","position":{"start":{"line":11,"column":1},"end":{"line":11,"column":1}},"key":"dJck9cWtGW"}],"key":"Fl6eKYtwan"},{"type":"text","value":"\nThis material would be organised according to the target audience.","position":{"start":{"line":11,"column":1},"end":{"line":11,"column":1}},"key":"NA3vV2i51l"}],"key":"cMuI4jpjuu"},{"type":"heading","depth":3,"position":{"start":{"line":16,"column":1},"end":{"line":16,"column":1}},"children":[{"type":"text","value":"For the student","position":{"start":{"line":16,"column":1},"end":{"line":16,"column":1}},"key":"i4n4zhMW6E"}],"identifier":"for-the-student","label":"For the student","html_id":"for-the-student","implicit":true,"key":"W89wM79Gf4"},{"type":"paragraph","position":{"start":{"line":18,"column":1},"end":{"line":18,"column":1}},"children":[{"type":"text","value":"We envisage two kinds of student-facing lessons.","position":{"start":{"line":18,"column":1},"end":{"line":18,"column":1}},"key":"kp8mKRx5Xh"}],"key":"JuzsfUF5Ys"},{"type":"heading","depth":4,"position":{"start":{"line":20,"column":1},"end":{"line":20,"column":1}},"children":[{"type":"text","value":"Lessons section","position":{"start":{"line":20,"column":1},"end":{"line":20,"column":1}},"key":"aQNfsmTN0G"}],"identifier":"lessons-section","label":"Lessons section","html_id":"lessons-section","implicit":true,"key":"aCgJzbOg1M"},{"type":"paragraph","position":{"start":{"line":22,"column":1},"end":{"line":25,"column":1}},"children":[{"type":"text","value":"A series of lessons would teach Python fundamentals with no prerequisite knowledge.\nThis is to serve as a concise starting point to quickly allow someone to run and understand code.\nHere, the focus is briefly about setting up the conditions to run Python, but primarily about stating the principles of the language in a way that can be seen as applicable to Chemists and can serve as a reference later on.\nMost of the lessons would cover syntax and basic programming procedures, as such we would take inspiration from pre-existing resources from other fields or domain-agnostic.","position":{"start":{"line":22,"column":1},"end":{"line":22,"column":1}},"key":"UMQ3F1Sdgi"}],"key":"NmhedEInLU"},{"type":"paragraph","position":{"start":{"line":27,"column":1},"end":{"line":27,"column":1}},"children":[{"type":"strong","position":{"start":{"line":27,"column":1},"end":{"line":27,"column":1}},"children":[{"type":"text","value":"Example:","position":{"start":{"line":27,"column":1},"end":{"line":27,"column":1}},"key":"MohsyXBNa6"}],"key":"VDB6Iu9n2t"},{"type":"text","value":" A lesson on loops explaining the ","position":{"start":{"line":27,"column":1},"end":{"line":27,"column":1}},"key":"ZIsa9uq1H4"},{"type":"inlineCode","value":"for","position":{"start":{"line":27,"column":1},"end":{"line":27,"column":1}},"key":"pZEaGs63VT"},{"type":"text","value":" syntax by iterating over IR absorbance data.","position":{"start":{"line":27,"column":1},"end":{"line":27,"column":1}},"key":"Krdc4nlpfW"}],"key":"wkokDLTW0F"},{"type":"heading","depth":4,"position":{"start":{"line":29,"column":1},"end":{"line":29,"column":1}},"children":[{"type":"text","value":"Activities section","position":{"start":{"line":29,"column":1},"end":{"line":29,"column":1}},"key":"HAQgO5U37m"}],"identifier":"activities-section","label":"Activities section","html_id":"activities-section","implicit":true,"key":"AXHrSILBES"},{"type":"paragraph","position":{"start":{"line":31,"column":1},"end":{"line":32,"column":1}},"children":[{"type":"text","value":"A series of self-contained activities where the student is led to accomplish a programmatic task relating to Chemistry.\nThe goal is to present loose recipes to common tasks. Some syntax would be introduced but there would be closer attention to intoducing programming patterns and code quality.","position":{"start":{"line":31,"column":1},"end":{"line":31,"column":1}},"key":"P3uBmQU5l7"}],"key":"Wi52aGcENd"},{"type":"paragraph","position":{"start":{"line":34,"column":1},"end":{"line":34,"column":1}},"children":[{"type":"strong","position":{"start":{"line":34,"column":1},"end":{"line":34,"column":1}},"children":[{"type":"text","value":"Example:","position":{"start":{"line":34,"column":1},"end":{"line":34,"column":1}},"key":"hZtd1froZ4"}],"key":"xj25loFpol"},{"type":"text","value":" An activity that teaches you how to plot an IR spectrum and indicate the point of lowest absorbance.","position":{"start":{"line":34,"column":1},"end":{"line":34,"column":1}},"key":"gMyFQamw4j"}],"key":"tAFkqmTTqb"},{"type":"heading","depth":3,"position":{"start":{"line":36,"column":1},"end":{"line":36,"column":1}},"children":[{"type":"text","value":"For the instructor","position":{"start":{"line":36,"column":1},"end":{"line":36,"column":1}},"key":"iFzEYCMX3U"}],"identifier":"for-the-instructor","label":"For the instructor","html_id":"for-the-instructor","implicit":true,"key":"TXktKSS2IB"},{"type":"paragraph","position":{"start":{"line":38,"column":1},"end":{"line":38,"column":1}},"children":[{"type":"text","value":"There would be a section dedicated to tools for instructors.","position":{"start":{"line":38,"column":1},"end":{"line":38,"column":1}},"key":"ZgZoOZvJY9"}],"key":"B9LUgGhdXy"},{"type":"heading","depth":4,"position":{"start":{"line":40,"column":1},"end":{"line":40,"column":1}},"children":[{"type":"text","value":"Datasets","position":{"start":{"line":40,"column":1},"end":{"line":40,"column":1}},"key":"LGTzrGwqOk"}],"identifier":"datasets","label":"Datasets","html_id":"datasets","implicit":true,"key":"khz3B1kxNs"},{"type":"paragraph","position":{"start":{"line":42,"column":1},"end":{"line":45,"column":1}},"children":[{"type":"text","value":"Obtaining input data is often a deceptively tricky step for an example code.\nIt’s useful for demonstrations, setting exercises, and assessment.\nWe would host a variety of datasets to be used at the instructors’ discretion.\nThey would systematically be labelled with metadata to track their origin and significance.","position":{"start":{"line":42,"column":1},"end":{"line":42,"column":1}},"key":"NfLUoNYm1r"}],"key":"iOAESaZKR1"},{"type":"heading","depth":4,"position":{"start":{"line":47,"column":1},"end":{"line":47,"column":1}},"children":[{"type":"text","value":"Assessments","position":{"start":{"line":47,"column":1},"end":{"line":47,"column":1}},"key":"bG4OjzAMfy"}],"identifier":"assessments","label":"Assessments","html_id":"assessments","implicit":true,"key":"lutO0TqO9Q"},{"type":"paragraph","position":{"start":{"line":49,"column":1},"end":{"line":51,"column":1}},"children":[{"type":"text","value":"Instructors are already showing great creativity in designing assessments for each of their contexts.\nSome examples are Jupyter- or VLE-based quizzes, bounded exercises, or programming projects.\nWe propose that instructors could share their ideas for assessment along with advice for how best to run them.","position":{"start":{"line":49,"column":1},"end":{"line":49,"column":1}},"key":"ANs6qX2iDq"}],"key":"k0ZXcH3uvz"},{"type":"heading","depth":3,"position":{"start":{"line":53,"column":1},"end":{"line":53,"column":1}},"children":[{"type":"text","value":"For the contributor","position":{"start":{"line":53,"column":1},"end":{"line":53,"column":1}},"key":"hIjqZoyTyQ"}],"identifier":"for-the-contributor","label":"For the contributor","html_id":"for-the-contributor","implicit":true,"key":"CAmhPrL3Ic"},{"type":"paragraph","position":{"start":{"line":55,"column":1},"end":{"line":56,"column":1}},"children":[{"type":"text","value":"We felt strongly that this project should be open-source.\nAs such, contribution guidelines should be strict and easy to follow.","position":{"start":{"line":55,"column":1},"end":{"line":55,"column":1}},"key":"bczcvJX4lI"}],"key":"vNcVfu1qlW"},{"type":"paragraph","position":{"start":{"line":58,"column":1},"end":{"line":61,"column":1}},"children":[{"type":"text","value":"The initial aim is to share existing material.\nHowever, over time, we hope to instantiate metadata for each element of existing material, including concepts of pre-requisites.\nFrom this metadata, it may be possible to design “pick-and-mix” style courses that reach across the different existing resources.\nWe would also welcome new bespoke content, ideally organised in short self-contained pages, so as to remain modular.","position":{"start":{"line":58,"column":1},"end":{"line":58,"column":1}},"key":"D1vECPNaO3"}],"key":"IvJud7cPXV"},{"type":"paragraph","position":{"start":{"line":63,"column":1},"end":{"line":63,"column":1}},"children":[{"type":"text","value":"We hope to formalise these guidelines as we go so as to best make use of the diverse sources of preexisting material while keeping the content easily approachable to the new reader.","position":{"start":{"line":63,"column":1},"end":{"line":63,"column":1}},"key":"ozw7F2UrEm"}],"key":"kIchiu5Ma1"},{"type":"heading","depth":2,"position":{"start":{"line":65,"column":1},"end":{"line":65,"column":1}},"children":[{"type":"text","value":"IP and funding","position":{"start":{"line":65,"column":1},"end":{"line":65,"column":1}},"key":"qqtnAYDGRN"}],"identifier":"ip-and-funding","label":"IP and funding","html_id":"ip-and-funding","implicit":true,"key":"laZABTUeI1"},{"type":"paragraph","position":{"start":{"line":67,"column":1},"end":{"line":70,"column":1}},"children":[{"type":"text","value":"Since this is a project about sharing teaching resources, we enter the sticky region of intellectual property, where some universities may be opposed to their employees contributing.\nWherever an employer would be of concern, we advise not to share preexisting material.\nA safer way of participating would be to collaborate on new resources across institutions, thus spreading out the university’s claim on the material.\nThe contributing institution would still have their role credited very visibly and we would aim to make this a boon for the university in terms of impact and visibility, rather than a drain on resources.","position":{"start":{"line":67,"column":1},"end":{"line":67,"column":1}},"key":"fGm4UcwewL"}],"key":"shtSURMGqy"},{"type":"paragraph","position":{"start":{"line":72,"column":1},"end":{"line":73,"column":1}},"children":[{"type":"text","value":"For this same reason, we need to access funding independent of universities to represent the interest of the Chemistry teaching community nationally.\nThis could pay for someone to dedicate their undivided time to the project and prevent any university from claiming ownership.","position":{"start":{"line":72,"column":1},"end":{"line":72,"column":1}},"key":"t9LT1zeOL1"}],"key":"UY6jgN8wXS"},{"type":"heading","depth":2,"position":{"start":{"line":75,"column":1},"end":{"line":75,"column":1}},"children":[{"type":"text","value":"Miscellanea","position":{"start":{"line":75,"column":1},"end":{"line":75,"column":1}},"key":"NvjyrRdkeJ"}],"identifier":"miscellanea","label":"Miscellanea","html_id":"miscellanea","implicit":true,"key":"Jt1voNaQFM"},{"type":"paragraph","position":{"start":{"line":77,"column":1},"end":{"line":78,"column":1}},"children":[{"type":"text","value":"A variety of other important topics were discussed at the meeting, which could serve as conversation starters.\nHere is an inexhaustive list which we hope to continue reflecting and acting upon:","position":{"start":{"line":77,"column":1},"end":{"line":77,"column":1}},"key":"Yxh043Pn8X"}],"key":"y87Px13PnA"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":80,"column":1},"end":{"line":88,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":80,"column":1},"end":{"line":80,"column":1}},"children":[{"type":"paragraph","children":[{"type":"strong","position":{"start":{"line":80,"column":1},"end":{"line":80,"column":1}},"children":[{"type":"text","value":"Generative AI:","position":{"start":{"line":80,"column":1},"end":{"line":80,"column":1}},"key":"AItRuEnWFZ"}],"key":"ZK5po7vKre"},{"type":"text","value":" How can we make it our ally in teaching programming?","position":{"start":{"line":80,"column":1},"end":{"line":80,"column":1}},"key":"osMtXq8L17"}],"key":"PJ0eOiHvlI"}],"key":"lzfQq5U7Zv"},{"type":"listItem","spread":true,"position":{"start":{"line":81,"column":1},"end":{"line":82,"column":1}},"children":[{"type":"paragraph","children":[{"type":"strong","position":{"start":{"line":81,"column":1},"end":{"line":81,"column":1}},"children":[{"type":"text","value":"Community building:","position":{"start":{"line":81,"column":1},"end":{"line":81,"column":1}},"key":"gYkAUDZsNB"}],"key":"htZeVY4yNe"},{"type":"text","value":" How will we stay in touch?\nWe have started a ","position":{"start":{"line":81,"column":1},"end":{"line":81,"column":1}},"key":"Cfo4dtQRxQ"},{"type":"link","url":"https://github.com/orgs/pythoninchemistry/discussions","position":{"start":{"line":81,"column":1},"end":{"line":81,"column":1}},"children":[{"type":"text","value":"GitHub discussion board","position":{"start":{"line":81,"column":1},"end":{"line":81,"column":1}},"key":"ZNTj7hlGL1"}],"urlSource":"https://github.com/orgs/pythoninchemistry/discussions","error":true,"key":"BvARnzSEGG"},{"type":"text","value":" which can serve as our HQ.","position":{"start":{"line":81,"column":1},"end":{"line":81,"column":1}},"key":"qFyjPASQBz"}],"key":"AzGqAS0B8Q"}],"key":"S4tDXotNdk"},{"type":"listItem","spread":true,"position":{"start":{"line":83,"column":1},"end":{"line":83,"column":1}},"children":[{"type":"paragraph","children":[{"type":"strong","position":{"start":{"line":83,"column":1},"end":{"line":83,"column":1}},"children":[{"type":"text","value":"Teaching teachers:","position":{"start":{"line":83,"column":1},"end":{"line":83,"column":1}},"key":"WjTcCXpmk9"}],"key":"QX4TP6Ef1D"},{"type":"text","value":" What sort of interventions can we propose to help introduce Python in the teaching of colleagues?","position":{"start":{"line":83,"column":1},"end":{"line":83,"column":1}},"key":"oMJEeDfHDv"}],"key":"mXJ2BD96HR"}],"key":"a3DdqrSPch"},{"type":"listItem","spread":true,"position":{"start":{"line":84,"column":1},"end":{"line":84,"column":1}},"children":[{"type":"paragraph","children":[{"type":"strong","position":{"start":{"line":84,"column":1},"end":{"line":84,"column":1}},"children":[{"type":"text","value":"RSC accreditation:","position":{"start":{"line":84,"column":1},"end":{"line":84,"column":1}},"key":"wax9l95XVv"}],"key":"VedEar3lau"},{"type":"text","value":" What place does programming have as a skill in the eyes of accreditation? Can we help to formalise this better?","position":{"start":{"line":84,"column":1},"end":{"line":84,"column":1}},"key":"Bec6goKuXK"}],"key":"Epxqw7xiqb"}],"key":"Gww9XbyqQo"},{"type":"listItem","spread":true,"position":{"start":{"line":85,"column":1},"end":{"line":85,"column":1}},"children":[{"type":"paragraph","children":[{"type":"strong","position":{"start":{"line":85,"column":1},"end":{"line":85,"column":1}},"children":[{"type":"text","value":"Notebooks and code editors:","position":{"start":{"line":85,"column":1},"end":{"line":85,"column":1}},"key":"TLw9ccEOS3"}],"key":"MHQIqQy5MM"},{"type":"text","value":" What is the best environment to write and run Python for a Chemistry student?","position":{"start":{"line":85,"column":1},"end":{"line":85,"column":1}},"key":"WsV4jdVrkl"}],"key":"ILw6y5zV4i"}],"key":"uPZlTK4i8g"},{"type":"listItem","spread":true,"position":{"start":{"line":86,"column":1},"end":{"line":88,"column":1}},"children":[{"type":"paragraph","children":[{"type":"strong","position":{"start":{"line":86,"column":1},"end":{"line":86,"column":1}},"children":[{"type":"text","value":"Follow-up meetings:","position":{"start":{"line":86,"column":1},"end":{"line":86,"column":1}},"key":"n61bgDK0BK"}],"key":"BdaHx8QBad"},{"type":"text","value":" We are interested in having an annual in-person meeting (delegates from the University of York offered to arrange this event).\nWe would also like to set up more frequent online meetings where different departments woul present their approach to teaching Python.","position":{"start":{"line":86,"column":1},"end":{"line":86,"column":1}},"key":"Hyi5I3SzCW"}],"key":"qri29hG017"}],"key":"K7YkzfkVqB"}],"key":"rop7I28L5H"},{"type":"heading","depth":2,"position":{"start":{"line":89,"column":1},"end":{"line":89,"column":1}},"children":[{"type":"text","value":"Conclusion","position":{"start":{"line":89,"column":1},"end":{"line":89,"column":1}},"key":"I28VqNtv6u"}],"identifier":"conclusion","label":"Conclusion","html_id":"conclusion","implicit":true,"key":"kRFIflryZp"},{"type":"paragraph","position":{"start":{"line":91,"column":1},"end":{"line":92,"column":1}},"children":[{"type":"text","value":"Overall the appetite for this meeting and the quality of conversations drove home how much we had been missing a community of practice.\nWatch this space for more news about our projects and hopefully more posts about Python in Chemsitry!","position":{"start":{"line":91,"column":1},"end":{"line":91,"column":1}},"key":"maHsJuVCq5"}],"key":"iUo54q3nwx"},{"type":"paragraph","position":{"start":{"line":94,"column":1},"end":{"line":94,"column":1}},"children":[{"type":"text","value":"Finally, we would like to thank everyone who joined and hope to continue the conversation with them and the ","position":{"start":{"line":94,"column":1},"end":{"line":94,"column":1}},"key":"zwHIQja41s"},{"type":"link","url":"https://github.com/orgs/pythoninchemistry/discussions","position":{"start":{"line":94,"column":1},"end":{"line":94,"column":1}},"children":[{"type":"text","value":"wider community online","position":{"start":{"line":94,"column":1},"end":{"line":94,"column":1}},"key":"ue7CzrkDMl"}],"urlSource":"https://github.com/orgs/pythoninchemistry/discussions","error":true,"key":"tWEMdhSySX"},{"type":"text","value":".","position":{"start":{"line":94,"column":1},"end":{"line":94,"column":1}},"key":"oilpPnkW64"}],"key":"NbMKtFvE3b"},{"type":"thematicBreak","key":"eYqxpmcNvL"},{"type":"image","url":"/python_lessons/build/group-photo-391ce598dbf38161b374cc77ba1aded1.jpeg","alt":"A group photograph taken at the meeting at UCL","width":"600px","align":"center","key":"tvGRvpynib","urlSource":"./assets/img/group-photo.jpeg"}],"key":"g7JVlJPqTs"}],"key":"ivMxgyYtIw"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"State of Teaching","url":"/state-of-teaching","group":"Blog"},"next":{"title":"Code of Conduct","url":"/community-docs/code-of-conduct","group":"Community Documentation"}}},"domain":"http://localhost:3000"}