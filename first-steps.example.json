"code","lang":"python","value":"\"\"\"\nUV spectrum analyser\n\nInput a spectrum in nm units and csv format.\n\n\"\"\"\n\nimport matplotlib.pyplot as plt\n\n# parse csv data\nfile_name = \"benzene_uv-vis_nm.csv\"\n\nwavelengths = []\nabsorbances = []\n\nwith open(file_name) as spec_file:\n    for line in spec_file:\n        # only conserve lines that start with a number\n        # to skip header\n        if line[0].isdigit():\n            split_line = line.split(\",\")\n            wavelengths.append(float(split_line[0]))\n            absorbances.append(float(split_line[1]))\n\nprint(wavelengths[-1],absorbances[-1])","position":{"start":{"line":46,"column":1},"end":{"line":72,"column":1}},"key":"skJeJpShaR"},{"type":"admonition","children":[{"type":"admonitionTitle","children":[{"type":"text","value":"Task","position":{"start":{"line":74,"column":1},"end":{"line":74,"column":1}},"key":"FuU2gnO3FZ"}],"key":"KAHK79HWqc"},{"type":"paragraph","position":{"start":{"line":75,"column":1},"end":{"line":76,"column":1}},"children":[{"type":"text","value":"Paste the code above into Spyder, save it in your working folder, and run it. Check that the output matches the\nbottom line of your csv file.","position":{"start":{"line":75,"column":1},"end":{"line":75,"column":1}},"key":"TPk7xSRaRg"}],"key":"SW3xane4nK"}],"key":"JHw6oGyAG0"},{"type":"paragraph","position":{"start":{"line":79,"column":1},"end":{"line":79,"column":1}},"children":[{"type":"text","value":"Let’s look at a few features of how Python is written, using this as an example.","position":{"start":{"line":79,"column":1},"end":{"line":79,"column":1}},"key":"pynqSYXYBx"}],"key":"ykSphUOUzg"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":81,"column":1},"end":{"line":109,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":81,"column":1},"end":{"line":86,"column":1}},"children":[{"type":"paragraph","position":{"start":{"line":81,"column":1},"end":{"line":85,"col