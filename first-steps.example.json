s.append(energies[i+2])\n\n# plot results\nfig, ax = plt.subplots()\nax.plot(energies,absorbances,label=\"Benzene absorption\",zorder=1)\nax.scatter(peak_energies,peak_absorbances,color='orange',label=\"Peaks\",zorder=2)\nax.hlines(threshold,energies[0],energies[-1],linestyle='--',color='orange',label=\"Threshold\")\nax.set_xlabel(\"Energy / eV\")\nax.set_ylabel(\"Absorbance\")\nax.legend()","position":{"start":{"line":124,"column":1},"end":{"line":154,"column":1}},"key":"txvDpxMzEh"},{"type":"paragraph","position":{"start":{"line":156,"column":1},"end":{"line":157,"column":1}},"children":[{"type":"text","value":"Using the comments, try to understand what each section of the code\naccomplishes.","position":{"start":{"line":156,"column":1},"end":{"line":156,"column":1}},"key":"YbqSQuhMoh"}],"key":"e6RYRAvK0Q"}],"key":"IeJkFVaxjd"},{"type":"paragraph","position":{"start":{"line":161,"column":1},"end":{"line":164,"column":1}},"children":[{"type":"text","value":"You should see a plot on the top right of the window. The spectrum looks fine\nbut our peak detection seems to have failed. Our strategy was to look at each\nabsorbance value and check that it is strictly higher than the value before and\nafter.","position":{"start":{"line":161,"column":1},"end":{"line":161,"column":1}},"key":"MzgM7xhysZ"}],"key":"EgR8aNmAWh"},{"type":"admonition","children":[{"type":"admonitionTitle","children":[{"type":"text","value":"Task","position":{"start":{"line":166,"column":1},"end":{"line":166,"column":1}},"key":"daGcVvM5LB"}],"key":"KXOU9OmaQI"},{"type":"paragraph","position":{"start":{"line":167,"column":1},"end":{"line":167,"column":1}},"children":[{"type":"text","value":"Investigate the ","position":{"start":{"line":167,"column":1},"end":{"line":167,"column":1}},"key":"nZXaYv53iQ"},{"type":"inlineCode","value":".csv","position":{"start":{"line":167,"column":1},"end":{"line":167,"column":1}},"key":"Tea7MPqujM"},{"type":"text","value":" data and work out why our peak peaking strategy